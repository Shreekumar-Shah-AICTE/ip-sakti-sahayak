# Secrets — never commit
.env
.env.*
!.env.example
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# Node / web
node_modules/
web/dist/
# Logs and local state
*.log
*.sqlite
# The audit trail is local operational data, not source
var/

# The Library: large raw source files are re-fetched and sha256-verified, not committed
corpus/cache/
