# ---------------------------------------------------------------------------
# IP-SAKTI Sahayak — optional API keys.
#
#   1. Copy this file to `.env` in the same folder.
#   2. Paste your Gemini key after GEMINI_API_KEY= below.
#   3. Run `python run.py`.
#
# That is all. `.env` is git-ignored, so your key is never committed.
# With no key the app still runs completely: retrieval, the Status Ledger,
# verbatim quotes, the calculators and the Claim Sentry need no network.
# ---------------------------------------------------------------------------

# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternatives. Any one of these switches the app online; Gemini is used first.
GROQ_API_KEY=
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Advanced (leave these alone unless you mean it).
#   SAHAYAK_MODE=offline  forces keyless behaviour even if a key is present.
#   SAHAYAK_MODE=online   forces online behaviour.
#   SAHAYAK_LLM / SAHAYAK_MT / SAHAYAK_CHAT_LLM = auto | gemini | groq | none
# ---------------------------------------------------------------------------
