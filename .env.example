# Optional adapters. The app runs fully offline with none of these set.
# Copy to .env (git-ignored) and fill in only what you have.
GEMINI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# The Conversation: optional general-Ayurveda LLM for non-legal chat only.
# auto (default) = Groq if GROQ_API_KEY is set, else Gemini, else replayed answers.
# Set to none to keep general chat fully offline. It is never used for legal answers.
SAHAYAK_CHAT_LLM=auto
